DATABASE_URL=postgresql://futurex:change-me@db:5432/futurex?schema=public
SESSION_COOKIE_NAME=futurex_session
SESSION_TTL_HOURS=12
PRIVATE_STORAGE_ROOT=/var/lib/futurex/private
# Use `vercel-blob` only after connecting a Private Blob store to the Vercel project.
PRIVATE_STORAGE_BACKEND=filesystem
BLOB_READ_WRITE_TOKEN=
APP_ORIGIN=https://finance.example.com
UPCOMING_EXHIBITIONS_POSTER_PATH=/var/lib/futurex/branding/upcoming-exhibitions.jpg
# Staff sign in with a short ID such as "jagriti", stored as jagriti@<LOGIN_ID_DOMAIN>
LOGIN_ID_DOMAIN=futurex.local
# SendGrid: API key with "Mail Send" permission and a verified sender. Never commit real values.
SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=verified-sender@example.com
SENDGRID_FROM_NAME=Accounts Futurex Trade
SENDGRID_REPLY_TO=verified-sender@example.com
SENDGRID_AUTO_SEND=false
SENDGRID_DRY_RUN=false
# Default address offered for Admin test emails
EMAIL_TEST_RECIPIENT=
# Admin MFA is prepared but must stay disabled until enrollment and recovery are verified.
# Generate a fresh 32-byte base64url key in the deployment secret store; never commit it.
MFA_ENCRYPTION_KEY=
ADMIN_MFA_ENROLLMENT_ENABLED=false
ADMIN_MFA_REQUIRED=false
